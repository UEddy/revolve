# Copy to solver/.env (gitignored). Never commit the real file.
# Unified full viewing key of the solver account. Only its Orchard component is imported.
REVOLVE_UFVK=uview1...
# Height to start scanning from (the wallet birthday).
REVOLVE_BIRTHDAY=3531480
REVOLVE_NETWORK=main
REVOLVE_LIGHTWALLETD=https://eu.zec.rocks:443
# 1 = route lightwalletd traffic through Tor (arti, embedded).
REVOLVE_TOR=1
REVOLVE_DATA_DIR=./data
# Seconds between sync rounds.
REVOLVE_POLL_SECS=30
# Stop re-emitting a note once it has this many confirmations.
REVOLVE_EMIT_UNTIL_CONFS=12
