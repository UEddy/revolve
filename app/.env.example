# Worker base URL (Account A's order API), or "mock" for a demo with no money.
VITE_ORDER_API=mock

# Relay upstreams (server side only, never shipped to the browser).
# A private RPC endpoint avoids the public one's rate limits.
SOLANA_RPC_URL=
# Optional Jupiter API key (uses api.jup.ag when set, lite-api.jup.ag otherwise).
JUP_API_KEY=
