# Needed for `npm run build` (the build fails without them, and on "mock").
# Worker base URL (API_CONTRACT.md).
VITE_ORDER_API=https://api.revolve.example
# Privacy relay base URL (../relay, on the droplet).
VITE_RELAY_URL=https://relay.revolve.example

# `npm run dev` only: leave VITE_ORDER_API unset for the demo order service.
# The dev server runs the relay itself at /api with these upstreams:
SOLANA_RPC_URL=
JUP_API_KEY=
