# Copy to worker/.env (gitignored). Never commit the real file.
PORT=8787
# Only this origin may call the API from a browser.
APP_ORIGIN=https://revolve.example
# Orchard-only UA printed by `revolve-watcher address`.
DEPOSIT_UA=u1...
DB_PATH=./data/worker.sqlite

# Watcher child process (built from ../solver). Its own env file holds the UFVK.
WATCHER_BIN=../solver/target/release/revolve-watcher
WATCHER_ENV_FILE=../solver/.env

# Solana hot wallet: a capped inventory keypair stored OUTSIDE the repo.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_KEYPAIR_PATH=/etc/revolve/hot-wallet.json
# Lamports always kept back for payout fees.
SOL_RESERVE_LAMPORTS=10000000

# Pricing. LAMPORTS_PER_ZEC fixes the rate; leave empty to use the live price.
LAMPORTS_PER_ZEC=
SPREAD_BPS=150
# Added to every payout so the burner can pay for its Jupiter swap.
SWAP_FEE_LAMPORTS=5000000
QUOTE_TTL_SECS=900
MAX_OPEN_ORDERS=20

# Credits mint (CREDITS_CONTRACT.md): RSA PKCS#8 PEM made by `node src/mint-keygen.ts`,
# stored OUTSIDE the repo. Leave MINT_KEY_PATH empty to disable /mint.
MINT_KEY_PATH=
MINT_KEY_ID=k1
# Base payouts (API_CONTRACT.md v1.4). The EVM hot wallet key (0x + 64 hex), made
# with `node src/evm-keygen.ts <path>` OUTSIDE the repo. Empty leaves Base off.
EVM_KEY_PATH=
BASE_RPC_URL=https://mainnet.base.org
# 0.0002 ETH kept for payout gas; caps of 0.1 ETH held and paid per UTC day.
BASE_RESERVE_WEI=200000000000000
BASE_HOT_WALLET_CAP_WEI=100000000000000000
BASE_DAILY_PAYOUT_CAP_WEI=100000000000000000
# Added to each payout for the fresh wallet's own swap gas (0.00003 ETH).
BASE_GAS_ALLOWANCE_WEI=30000000000000
# Optional fixed rate instead of the live price, wei per ZEC.
WEI_PER_ZEC=
# Withdrawals to shielded ZEC (CREDITS_CONTRACT.md v1.5): the payer-* commands' env
# file (seed path, birthday, data dir). Empty leaves withdrawals off.
ZEC_PAYER_ENV_FILE=
# The most withdrawn per UTC day, in zatoshis (0.5 ZEC).
WITHDRAW_DAILY_CAP_ZAT=50000000
