# /etc/caddy/Caddyfile on the droplet. Replaces the whole file.
#
#   https://revolveapp.duckdns.org/orders, /orders/<id>, /limits, /buckets, /mint/*,
#     /cashins, /cashins/*, /withdrawals, /withdrawals/*                        -> worker (127.0.0.1:8787)
#   (worker/test/caddy.test.ts fails if a worker route is missing here)
#   https://revolveapp.duckdns.org/relay/*                         -> relay  (127.0.0.1:8788), prefix stripped
#   anything else                                                  -> 404
#
# The app is built with
#   VITE_ORDER_API=https://revolveapp.duckdns.org
#   VITE_RELAY_URL=https://revolveapp.duckdns.org/relay
#
# No `log` directive on purpose: Caddy keeps no access logs unless told to, so
# client IPs are never recorded. The client IP is also not forwarded upstream.

revolveapp.duckdns.org {
	# Every response: HTTPS only, no sniffing, no framing, no referrer, no
	# powerful features, and nothing that names the server software. The
	# worker and relay only ever answer JSON or images, so a CSP of 'none'
	# costs nothing and stops any response from running as a page.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		Cross-Origin-Resource-Policy "cross-origin"
		-Server
		-Via
	}

	# The worker takes at most 128 KB (credit spends), the relay 64 KB.
	request_body {
		max_size 256KB
	}

	@worker path /orders /orders/* /limits /buckets /mint/* /cashins /cashins/* /withdrawals /withdrawals/*
	handle @worker {
		reverse_proxy 127.0.0.1:8787 {
			header_up -X-Forwarded-For
			header_up -X-Real-IP
		}
	}

	handle_path /relay/* {
		reverse_proxy 127.0.0.1:8788 {
			header_up -X-Forwarded-For
			header_up -X-Real-IP
		}
	}

	handle {
		respond 404
	}
}
