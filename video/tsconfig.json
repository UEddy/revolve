{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "exclude": [
    "remotion.config.ts"
  ],
  "include": [
    "src",
    "remotion.config.ts"
  ]
}
