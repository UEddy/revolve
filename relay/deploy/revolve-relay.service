# systemd unit for the relay on the droplet. Adjust paths and user to the
# droplet's layout (the worker's checkout lives next to it).
[Unit]
Description=Revolve privacy relay
After=network-online.target
Wants=network-online.target

[Service]
User=revolve
WorkingDirectory=/opt/revolve/relay
Environment=RELAY_ENV_FILE=/opt/revolve/relay/.env
ExecStart=/usr/bin/node src/main.ts
Restart=always
RestartSec=2
# 512 MB droplet shared with the watcher and worker: the response cache is
# capped at 24 MB, so this leaves room for Node itself.
MemoryMax=128M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Writes nothing to disk: no ReadWritePaths at all.
# No privileges at all: no capabilities, no new ones, no kernel or device
# access, files created private to the service. (MemoryDenyWriteExecute is
# left out on purpose: Node's JIT needs writable executable memory.)
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap

[Install]
WantedBy=multi-user.target
